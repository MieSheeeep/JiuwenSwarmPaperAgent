+++ b/jiuwenswarm/agents/harness/common/rails/frozen_messages_rail.py
@@ -0,0 +1,135 @@
+"""Opt-in exact-message, single-response AgentRail for a fresh ReActAgent."""
+import copy
+import logging
+
+logging.disable(logging.CRITICAL)
+
+from openjiuwen.core.context_engine.base import ContextWindow
+from openjiuwen.core.foundation.llm.schema.message import AssistantMessage, SystemMessage, UserMessage
+from openjiuwen.core.single_agent.rail.base import AgentRail
+
+
+class FrozenMessagesError(RuntimeError):
+    """Exact prompt or single-response transport contract was violated."""
+
+
+def canonical_messages(messages):
+    """Capture the SDK transport's actual roles/content without string coercion."""
+    return [{'role': m.get('role'), 'content': copy.deepcopy(m.get('content'))}
+            if isinstance(m, dict) else
+            {'role': getattr(m, 'role', None), 'content': copy.deepcopy(getattr(m, 'content', None))}
+            for m in messages]
+
+
+def validate_messages(messages):
+    if not isinstance(messages, list) or not messages:
+        raise ValueError('Prepared messages must be a nonempty list')
+    for message in messages:
+        if (not isinstance(message, dict) or set(message) != {'role', 'content'}
+                or message['role'] not in {'system', 'user', 'assistant'}
+                or not isinstance(message['content'], str)):
+            raise ValueError('Prepared messages require only supported role and string content fields')
+    return copy.deepcopy(messages)
+
+
+class _FrozenContext:
+    """Override final window construction; preserve the original context API."""
+    def __init__(self, original, messages):
+        self._original = original
+        self._messages = messages
+
+    def __getattr__(self, name):
+        return getattr(self._original, name)
+
+    async def get_context_window(self, **kwargs):
+        # Keep all messages together, including system messages in their original
+        # position: ContextWindow otherwise prepends system_messages separately.
+        return ContextWindow(system_messages=[], context_messages=copy.deepcopy(self._messages), tools=[])
+
+
+class _CheckedModel:
+    """Final pre-transport admission guard, independent of SDK window rebuilds."""
+    def __init__(self, original, rail):
+        self._original = original
+        self._rail = rail
+
+    def __getattr__(self, name):
+        return getattr(self._original, name)
+
+    async def invoke(self, *args, **kwargs):
+        messages = kwargs.get('messages', args[0] if args else None)
+        actual = canonical_messages(messages or [])
+        if actual != self._rail.messages or kwargs.get('tools'):
+            raise FrozenMessagesError('Final model transport inputs differ from the prepared messages or contain tools')
+        if self._rail.transport_call_count:
+            raise FrozenMessagesError('Only one model transport invocation is permitted')
+        self._rail.transport_call_count += 1
+        self._rail.transport_messages = copy.deepcopy(actual)
+        return await self._original.invoke(*args, **kwargs)
+
+    async def stream(self, *args, **kwargs):
+        raise FrozenMessagesError('FrozenMessagesRail supports non-streaming single-response invokes only')
+        yield  # Make an async iterator; refusal still happens before transport.
+
+
+class FrozenMessagesRail(AgentRail):
+    """Inject exact prepared messages and synchronously retain each response.
+
+    For a fresh, tool-free agent only. Register once, invoke once. The final
+    transport guard rejects changed inputs before the delegated model call.
+    A callback receives (SDK response, actual role/content messages) before
+    post-response contract checks, preserving billable evidence on failures.
+    """
+    def __init__(self, messages, on_response=None):
+        super().__init__()
+        self.messages = validate_messages(messages)
+        self.on_response = on_response
+        self.responses = []
+        self.model_inputs = []
+        self.model_call_count = 0
+        self.transport_call_count = 0
+        self.transport_messages = None
+        self._original_context = None
+
+    def init(self, agent):
+        agent.set_llm(_CheckedModel(agent._get_llm(), self))
+
+    async def before_model_call(self, ctx):
+        if self.model_call_count:
+            raise FrozenMessagesError('Only one model call is permitted')
+        self.model_call_count += 1
+        classes = {'system': SystemMessage, 'user': UserMessage, 'assistant': AssistantMessage}
+        prepared = [classes[m['role']](content=m['content']) for m in self.messages]
+        self._original_context = ctx.context
+        ctx.context = _FrozenContext(ctx.context, prepared)
+        ctx.inputs.model_context = ctx.context
+        ctx.inputs.messages = copy.deepcopy(prepared)
+        ctx.inputs.tools = None
+
+    def _restore_context(self, ctx):
+        if self._original_context is not None:
+            ctx.context = self._original_context
+            ctx.inputs.model_context = self._original_context
+            self._original_context = None
+
+    async def on_model_exception(self, ctx):
+        self._restore_context(ctx)
+
+    async def after_model_call(self, ctx):
+        try:
+            response = ctx.inputs.response
+            if response is None:
+                return
+            if self.responses:
+                raise FrozenMessagesError('Only one response is permitted')
+            actual = canonical_messages(ctx.inputs.messages)
+            self.responses.append(response)
+            self.model_inputs.append(copy.deepcopy(actual))
+            if self.on_response is not None:
+                self.on_response(response, copy.deepcopy(actual))
+            if actual != self.messages:
+                raise FrozenMessagesError('Actual response-associated messages differ from prepared messages')
+            if self.transport_messages is not None and actual != self.transport_messages:
+                raise FrozenMessagesError('Response messages differ from the captured transport inputs')
+        finally:
+            self._restore_context(ctx)
