index 0000000..73611a6
--- /dev/null
+++ b/jiuwenswarm/agents/harness/common/versioned_memory.py
@@ -0,0 +1,144 @@
+"""Opt-in structured, bitemporal source memory; standard library only.
+
+Selectors return source records, never resolved answers. Text is canonical JSONL
+and budgets apply to the complete joined text, including newline separators.
+"""
+import copy
+import json
+import math
+from pathlib import Path
+import re
+from collections import Counter
+
+POLICIES = ('full', 'recent', 'lexical', 'bm25', 'versioned', 'no_time', 'no_conflict')
+FIELDS = ('id', 'entity', 'attribute', 'value', 'valid_at', 'observed_at', 'operation')
+
+
+def _serialize(record):
+    return json.dumps(record, ensure_ascii=False, sort_keys=True, separators=(',', ':'), allow_nan=False)
+
+
+def _validate_records(records):
+    output, seen = [], set()
+    for record in records:
+        if not isinstance(record, dict) or any(key not in record for key in FIELDS):
+            raise ValueError('record requires all structured source fields')
+        if any(not isinstance(record[key], str) or not record[key] for key in ('id', 'entity', 'attribute')):
+            raise ValueError('id, entity and attribute must be nonempty strings')
+        if record['id'] in seen:
+            raise ValueError('record IDs must be unique')
+        if any(type(record[key]) is not int for key in ('valid_at', 'observed_at')):
+            raise ValueError('timestamps must be integers')
+        if record['operation'] not in ('set', 'delete'):
+            raise ValueError('operation must be set or delete')
+        if record['value'] is not None and not isinstance(record['value'], (str, int, float, bool)):
+            raise ValueError('value must be a JSON scalar')
+        # Exclude extra fields (including accidental evaluation annotations).
+        item = {key: copy.deepcopy(record[key]) for key in FIELDS}
+        _serialize(item)
+        output.append(item)
+        seen.add(record['id'])
+    return output
+
+
+class VersionedMemoryStore:
+    """Append-only source history with lossless JSONL save/load."""
+    def __init__(self, records=()):
+        self._records = _validate_records(records)
+
+    @property
+    def records(self):
+        return copy.deepcopy(self._records)
+
+    def append(self, record):
+        self._records = _validate_records([*self._records, record])
+
+    def save(self, path):
+        Path(path).write_text('\n'.join(map(_serialize, self._records)), encoding='utf-8')
+
+    @classmethod
+    def load(cls, path):
+        return cls(json.loads(line) for line in Path(path).read_text(encoding='utf-8').splitlines() if line.strip())
+
+
+def _terms(text):
+    return re.findall(r'\w+', text.casefold())
+
+
+def select_records(records, query, policy, budget, count_tokens):
+    """Select raw source records under one explicit policy.
+
+    Baseline policies rank the supplied history without temporal filtering.
+    Structured policies filter entity/attributes and apply query cutoffs. Groups
+    costed least-first maximize attribute coverage; ties follow query order.
+    Equal-valid-time evidence is atomic, preventing conflict erasure by packing.
+    """
+    records = _validate_records(records)
+    if policy not in POLICIES:
+        raise ValueError('unknown selection policy: ' + str(policy))
+    if type(budget) is not int or budget < 0:
+        raise ValueError('budget must be a nonnegative integer')
+    if (not isinstance(query.get('entity'), str) or
+            not isinstance(query.get('attributes'), list) or
+            not all(isinstance(a, str) for a in query['attributes']) or
+            any(type(query.get(k)) is not int for k in ('as_of', 'known_at'))):
+        raise ValueError('query requires entity, attributes and integer cutoffs')
+    lines = [_serialize(record) for record in records]
+    def render(indices):
+        return '\n'.join(lines[index] for index in indices)
+    def fits(indices):
+        return count_tokens(render(indices)) <= budget
+    selected, conflicts = [], []
+    if policy == 'full':
+        selected = list(range(len(records)))
+    elif policy == 'recent':
+        for index in reversed(range(len(records))):
+            candidate = [index, *selected]
+            if not fits(candidate):
+                break
+            selected = candidate
+    elif policy in ('lexical', 'bm25'):
+        query_terms = set(_terms(' '.join([query['entity'], *query['attributes'], str(query.get('question', ''))])))
+        documents = [_terms(line) for line in lines]
+        lengths = [len(doc) for doc in documents]
+        average = sum(lengths) / max(1, len(lengths))
+        frequencies = Counter(term for doc in documents for term in set(doc))
+        scores = []
+        for index, document in enumerate(documents):
+            counts = Counter(document)
+            if policy == 'lexical':
+                score = len(query_terms.intersection(counts))
+            else:
+                score = sum(math.log(1 + (len(documents) - frequencies[t] + .5) / (frequencies[t] + .5)) *
+                            counts[t] * 2.5 / (counts[t] + 1.5 * (.25 + .75 * lengths[index] / max(average, 1)))
+                            for t in query_terms if counts[t])
+            scores.append(score)
+        for index in sorted(range(len(records)), key=lambda i: (-scores[i], i)):
+            if fits([*selected, index]):
+                selected.append(index)
+    else:
+        groups = []
+        for attribute in dict.fromkeys(query['attributes']):
+            visible = [i for i, r in enumerate(records) if r['entity'] == query['entity'] and r['attribute'] == attribute
+                       and r['observed_at'] <= query['known_at']
+                       and (policy == 'no_time' or r['valid_at'] <= query['as_of'])]
+            if not visible:
+                continue
+            time_field = 'observed_at' if policy == 'no_time' else 'valid_at'
+            latest = max(records[i][time_field] for i in visible)
+            group = [i for i in visible if records[i][time_field] == latest]
+            if policy == 'no_conflict':
+                group = [max(group, key=lambda i: (records[i]['observed_at'], i))]
+            signatures = {(records[i]['operation'], _serialize(records[i]['value'])) for i in group}
+            if len(signatures) > 1:
+                conflicts.append(attribute)
+            groups.append(group)
+        # Choosing smallest atomic groups first maximizes represented attributes
+        # for the usual additive proxy. Always re-count joined text for safety.
+        for group in sorted(groups, key=lambda group: count_tokens(render(group))):
+            if fits([*selected, *group]):
+                selected.extend(group)
+        selected.sort()
+    text = render(selected)
+    return {'text': text, 'record_ids': [records[i]['id'] for i in selected],
+            'proxy_tokens': count_tokens(text), 'conflicts': conflicts}
