+"""Opt-in history selection for reproducible context-budget experiments.
+
+The token counter is supplied by the caller. This module never reads answer keys,
+credentials, or mutable global configuration. Selection retains whole records.
+"""
+import re
+
+
+def select_history(history, question, policy, budget, count_tokens):
+    if budget <= 0:
+        raise ValueError('budget must be positive')
+    if policy not in {'full', 'recent', 'retrieve'}:
+        raise ValueError('unsupported context policy')
+    if policy == 'full':
+        return list(history)
+    if policy == 'recent':
+        candidates = list(range(len(history) - 1, -1, -1))
+    else:
+        # This pilot deliberately evaluates transparent lexical project lookup.
+        # It is not semantic retrieval and has no access to the reference answer.
+        ids = re.findall(r'\bproject\s+(P\d+)\b', question, re.I)
+        patterns = [re.compile(r'\b' + re.escape(i) + r'\b', re.I) for i in ids]
+        candidates = [i for i in range(len(history) - 1, -1, -1)
+                      if any(p.search(history[i]) for p in patterns)]
+    chosen = []
+    for index in candidates:
+        trial = sorted(chosen + [index])
+        if count_tokens('\n'.join(history[i] for i in trial)) <= budget:
+            chosen = trial
+        elif policy == 'recent':
+            # Recent-window baseline is a contiguous suffix, never skip ahead.
+            break
+    return [history[i] for i in chosen]
